{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  // The load harness is developer tooling. It compiles through
  // tsconfig.loadtest.json into dist-loadtest so it never reaches the runtime
  // image, which packages dist only.
  "exclude": ["src/loadtest"]
}
