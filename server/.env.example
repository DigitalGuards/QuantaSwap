# Compose-only names. Keep the state volume stable across image updates.
ORDERBOOK_COMPOSE_PROJECT=quantaswap-orderbook
ORDERBOOK_STATE_VOLUME=quantaswap-orderbook-state
ORDERBOOK_KIT_VERSION=local
ORDERBOOK_PORT=8091

# Forwarded client addresses are ignored by default. Use `all` only when the
# published port remains host-loopback-only and a trusted reverse proxy
# overwrites CF-Connecting-IP and X-Forwarded-For. Native loopback deployments
# can use `loopback`; direct deployments should use `none`.
ORDERBOOK_TRUST_PROXY=none

# Runtime safety bounds.
PRESENCE_TTL_S=90
ORDERBOOK_REQUEST_TIMEOUT_MS=15000
ORDERBOOK_SHUTDOWN_TIMEOUT_MS=10000
ORDERBOOK_STREAM_BACKPRESSURE_MS=10000

# Optional federation. Each peer is an operator-reviewed order-book API base,
# for example https://book.example/api. Signed public protocol events are
# pulled, independently verified, deduplicated by content hash, and relayed.
# Private and unsigned orders never enter the feed.
ORDERBOOK_FEDERATION_PEERS=
ORDERBOOK_FEDERATION_SYNC_MS=5000
ORDERBOOK_FEDERATION_REQUEST_TIMEOUT_MS=10000

# Optional browser origins allowed to call this mirror directly. Same-origin
# deployments need no entry. Public book and federation reads use wildcard
# CORS; mutations only echo an origin listed here.
ORDERBOOK_CORS_ORIGINS=
