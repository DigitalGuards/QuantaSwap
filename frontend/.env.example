# Public Reown project id for WalletConnect. Empty uses the official
# quantaswap.io project, which only works on its allowlisted domains. A fork
# creates its own project at https://dashboard.reown.com (allowlisting its
# domains) and sets it here, or sets "off" to hide WalletConnect.
VITE_WALLETCONNECT_PROJECT_ID=

# Serve this build under a sub-path, so a previous release can stay reachable
# on the same origin after a contract cutover. Local swap state is scoped to
# the origin and namespaced on both HTLC addresses, so a build of the previous
# release at /v2/ reads exactly the records that deployment wrote.
# VITE_BASE_PATH=/v2/

# Where that previous release is served. Defaults to /v2/ at the site root,
# and to nothing when this build is itself under a sub-path. Set to an empty
# value to hide the link.
# VITE_LEGACY_RELEASE_PATH=/v2/
