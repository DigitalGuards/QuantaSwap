# QuantaSwap scripted taker configuration. The two keys are required and
# must never enter tracked files; everything else has a testnet default
# (see src/taker-config.ts). Copy to .env.taker and load it yourself, for
# example with `set -a; . ./.env.taker; set +a`.

# Signing keys. `npm run init:keys -- ./secrets` writes these untracked
# mode-0600 files; a taker may reuse a maker key pair or, preferably, hold
# its own. Direct TAKER_ETH_PRIVATE_KEY / TAKER_QRL_HEXSEED values are
# supported too, but never configure both forms of one secret.
TAKER_ETH_PRIVATE_KEY_FILE=./secrets/eth-private-key
TAKER_QRL_HEXSEED_FILE=./secrets/qrl-hexseed
#TAKER_ETH_PRIVATE_KEY=0x...
#TAKER_QRL_HEXSEED=0x...

# Endpoints. Use RPC infrastructure you control or independently trust:
# claim simulation necessarily discloses a preimage to the configured RPC
# immediately before broadcast. For a dry run, point the book at the
# staging deployment https://dev.quantaswap.io/api first.
TAKER_ORDERBOOK_URL=https://quantaswap.io/api
TAKER_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TAKER_QRL_RPC_URL=https://qrlwallet.com/api/qrl-rpc/testnet
#TAKER_ETH_CHAIN_ID=11155111
#TAKER_QRL_CHAIN_ID=3151909
# Exact HTLC defaults are pinned in ../config/protocol-v2.json.
#TAKER_ETH_HTLC=0x...
#TAKER_QRL_HTLC=Q...

# Safety windows (seconds unless stated).
# TAKER_CONFIRMATIONS: block depth the maker escrow must reach before this
#   client funds anything.
# TAKER_CLAIM_SAFETY_S: margin the maker escrow's own timeout must leave
#   beyond our deadline, or the escrow is refused.
# TAKER_LOCK_RUNWAY_S: refuse to fund this close to our own deadline.
# TAKER_MIN_ORDER_RUNWAY_S: refuse to propose against an order proof that
#   expires sooner than this.
# TAKER_RESEND_AFTER_S: re-send a transaction whose effect is still absent.
#TAKER_CONFIRMATIONS=3
#TAKER_CLAIM_SAFETY_S=600
#TAKER_LOCK_RUNWAY_S=900
#TAKER_MIN_ORDER_RUNWAY_S=900
#TAKER_RESEND_AFTER_S=240

# Gas headroom kept free on each leg, in wei. A take is refused when the
# funding account holds less than this in native balance.
#TAKER_ETH_GAS_RESERVE_WEI=2000000000000000
#TAKER_QRL_GAS_RESERVE_WEI=1000000000000000000

# Runtime. The state file holds walk-away secrets and the exact signed
# proofs a recovery needs: it is written 0600 and must be treated as a
# secret. One active process per state file (the process lease enforces it).
#TAKER_STATE_FILE=./data/taker-state.json
#TAKER_POLL_MS=5000
#TAKER_NET_TIMEOUT_MS=20000
#TAKER_TX_TIMEOUT_MS=180000
