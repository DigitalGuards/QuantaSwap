# QuantaSwap market maker configuration. The two keys are required and
# must never enter tracked files; everything else has sane testnet
# defaults (see src/config.ts).

# Signing keys (testnet inventory wallets, NOT the project funders)
MM_ETH_PRIVATE_KEY=0x...
MM_QRL_HEXSEED=0x...

# Endpoints (defaults assume running on the same box as the order book
# and the QRL node)
#MM_ORDERBOOK_URL=http://127.0.0.1:8091/api
#MM_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#MM_QRL_RPC_URL=http://127.0.0.1:8545

# Inventory policy (wei). Listings form a price ladder: level n quotes
# mid +/- (n+1)*step and (n+1)x the base size.
#MM_ORDERS_PER_DIRECTION=2
#MM_MAX_INFLIGHT=2
#MM_ETH_ORDER_WEI=20000000000000000
#MM_LEVEL_STEP_BPS=50

# Pricing. The mid tracks the live ETH/USD / QRL/USD cross rate from
# CoinGecko; open listings are cancelled and reposted when it drifts
# past the reprice threshold, and posting pauses (never quote blind)
# if the feed stays down past the max age. MM_PRICE_FEED=off pins
# MM_MID_PRICE_MILLI instead.
#MM_PRICE_FEED=coingecko
#MM_PRICE_REFRESH_S=300
#MM_PRICE_MAX_AGE_S=1800
#MM_REPRICE_THRESHOLD_BPS=100
#MM_MID_PRICE_MILLI=1700000
#MM_ETH_RESERVE_WEI=50000000000000000
#MM_QRL_RESERVE_WEI=5000000000000000000

# Swap timing (seconds)
#MM_CONFIRMATIONS=3
#MM_INITIATOR_WINDOW_S=7200
#MM_RESPONDER_WINDOW_S=3600
#MM_CLAIM_SAFETY_S=600
#MM_RESEND_AFTER_S=240
#MM_TICK_MS=15000

#MM_STATE_FILE=./data/state.json
