# QuantaSwap market maker configuration. The two keys are required and
# must never enter tracked files; everything else has sane testnet
# defaults (see src/config.ts).

# Signing keys (testnet inventory wallets, NOT the project funders)
MM_ETH_PRIVATE_KEY=0x...
MM_QRL_HEXSEED=0x...

# Endpoints (defaults assume running on the same box as the order book
# and the QRL node)
#MM_ORDERBOOK_URL=http://127.0.0.1:8091/api
#MM_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#MM_QRL_RPC_URL=http://127.0.0.1:8545
#MM_ETH_CHAIN_ID=11155111
#MM_QRL_CHAIN_ID=1337
#MM_ETH_HTLC=0x910D5d4a7f2037c01F3B4C835167357e89909281
#MM_QRL_HTLC=Q238322ad2e8f935b4481fcc379779c31b84decb0

# Chain IDs and HTLC addresses form a persisted deployment fingerprint.
# A non-empty legacy state file, or one from another deployment, is left
# untouched and refused at startup so old locks can be manually recovered
# with their original config instead of being re-locked after a cutover.
# Claim simulation sends the preimage to the configured RPC, so both RPC
# endpoints must be trusted and operated as security-sensitive services.

# ETH-leg assets to stock, comma list of registry symbols from
# src/assets.ts. Every entry needs a CoinGecko feed, so tUSDT (test-only
# faucet token, no feed) is rejected at startup. Default stocks native
# ETH only.
#MM_ASSETS=ETH,USDC

# Inventory policy (wei). Listings form a price ladder: level n quotes
# mid +/- (n+1)*step and (n+1)x the base size. MM_ORDERS_PER_LEVEL keeps
# that many identical listings per rung so concurrent takers can run the
# same trade side by side (size MM_MAX_INFLIGHT to match); it applies to
# every pair.
#MM_ORDERS_PER_DIRECTION=2
#MM_ORDERS_PER_LEVEL=1
#MM_MAX_INFLIGHT=2
#MM_ETH_ORDER_WEI=20000000000000000
#MM_LEVEL_STEP_BPS=50

# Per-asset knobs for token pairs, in human units (not base units):
# MM_<ASSET>_BASE is the rung-0 listing size, MM_<ASSET>_RESERVE stays
# unlisted as the inventory floor, MM_<ASSET>_ORDERS_PER_DIRECTION sets
# that pair's ladder rungs. The ETH pair keeps its wei knobs above. The
# ETH native balance is also the gas budget for token pairs (approve +
# lockToken + claim), so keep it above MM_ETH_RESERVE_WEI.
#MM_USDC_BASE=5
#MM_USDC_RESERVE=6
#MM_USDC_ORDERS_PER_DIRECTION=2

# Pricing. Each pair's mid tracks the live <asset>/USD / QRL/USD cross
# rate from CoinGecko (ETH and USDC feeds ship today); open listings are
# cancelled and reposted when their pair's mid drifts past the reprice
# threshold, and posting pauses per pair (never quote blind) if its feed
# stays down past the max age. MM_PRICE_FEED=off pins MM_MID_PRICE_MILLI
# for the ETH pair only; token pairs then post nothing.
#MM_PRICE_FEED=coingecko
#MM_PRICE_REFRESH_S=300
#MM_PRICE_MAX_AGE_S=1800
#MM_REPRICE_THRESHOLD_BPS=100
#MM_MID_PRICE_MILLI=1700000
#MM_ETH_RESERVE_WEI=50000000000000000
#MM_QRL_RESERVE_WEI=5000000000000000000

# Swap timing (seconds)
#MM_CONFIRMATIONS=3
#MM_INITIATOR_WINDOW_S=7200
#MM_RESPONDER_WINDOW_S=3600
#MM_CLAIM_SAFETY_S=600
#MM_RESEND_AFTER_S=240
#MM_TICK_MS=15000

# Every secret-bearing claim is simulated from the actual sender at
# "latest" immediately before submission. A failed simulation stops the
# broadcast. Token issuer changes and other state changes between the
# simulation and mining remain an unavoidable time-of-check/time-of-use
# risk, so keep responder timeouts and MM_CLAIM_SAFETY_S conservative.

#MM_STATE_FILE=./data/state.json
