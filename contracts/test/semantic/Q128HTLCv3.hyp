==== ExternalSource: _canonical/HTLCv3.hyp ====
==== ExternalSource: _canonical/MockTokens.hyp ====
==== Source: Q128HTLCv3.hyp ====
import {HTLCv3} from "_canonical/HTLCv3.hyp";
import {BlocklistToken} from "_canonical/MockTokens.hyp";

// Holds a credit on behalf of the harness. It has no receive function, so a
// native payout to it always fails and has to become a credit, and it can
// still name a destination that works.
contract CreditHolder {
    function pull(address htlc, address token, address to, uint256 amount) external {
        HTLCv3(htlc).withdraw(token, to, amount);
    }
}

contract Q128HTLCv3 {
    HTLCv3 private htlc;
    BlocklistToken private token;
    CreditHolder private holder;

    constructor() {
        htlc = new HTLCv3();
        token = new BlocklistToken();
        holder = new CreditHolder();
    }

    function exerciseTokenCreditAliases(address firstRecipient, address secondRecipient)
        external
        returns (bool)
    {
        token.mint(address(this), 100);
        token.approve(address(htlc), 100);
        token.setBlocked(firstRecipient, true);
        token.setBlocked(secondRecipient, true);

        bytes32 firstPreimage = bytes32(uint256(0xa1));
        bytes32 secondPreimage = bytes32(uint256(0xb2));
        bytes32 firstHashlock = sha256(abi.encodePacked(firstPreimage));
        bytes32 secondHashlock = sha256(abi.encodePacked(secondPreimage));
        uint256 timeout = type(uint256).max;

        htlc.lockToken(firstHashlock, firstRecipient, address(token), 11, timeout);
        htlc.lockToken(secondHashlock, secondRecipient, address(token), 13, timeout);
        htlc.claim(firstHashlock, firstPreimage);
        htlc.claim(secondHashlock, secondPreimage);

        require(htlc.creditOf(address(token), firstRecipient) == 11, "first credit aliased");
        require(htlc.creditOf(address(token), secondRecipient) == 13, "second credit aliased");
        require(htlc.outstandingCredit(address(token)) == 24, "outstanding total wrong");
        require(htlc.creditOf(address(token), address(this)) == 0, "credit leaked to the claimer");

        HTLCv3.Swap memory first = htlc.getSwap(firstHashlock);
        HTLCv3.Swap memory second = htlc.getSwap(secondHashlock);
        require(first.recipient == firstRecipient, "first recipient aliased");
        require(second.recipient == secondRecipient, "second recipient aliased");
        require(first.recipient != second.recipient, "recipient identities collapsed");
        require(first.preimage == firstPreimage, "first preimage not persisted");
        require(second.preimage == secondPreimage, "second preimage not persisted");
        require(uint8(first.status) == 2, "first swap not Claimed");
        require(uint8(second.status) == 2, "second swap not Claimed");
        return true;
    }

    function exerciseWithdrawDestinationAliases(address firstDestination, address secondDestination)
        external
        returns (bool)
    {
        token.mint(address(this), 100);
        token.approve(address(htlc), 100);
        token.setBlocked(address(holder), true);

        bytes32 preimage = bytes32(uint256(0xc3));
        bytes32 hashlock = sha256(abi.encodePacked(preimage));
        htlc.lockToken(hashlock, address(holder), address(token), 17, type(uint256).max);
        htlc.claim(hashlock, preimage);
        require(htlc.creditOf(address(token), address(holder)) == 17, "holder not credited");

        holder.pull(address(htlc), address(token), firstDestination, 5);
        holder.pull(address(htlc), address(token), secondDestination, 12);

        require(token.balanceOf(firstDestination) == 5, "first destination aliased");
        require(token.balanceOf(secondDestination) == 12, "second destination aliased");
        require(htlc.creditOf(address(token), address(holder)) == 0, "credit not cleared");
        return true;
    }

    function exerciseNativeCreditAliases(address destination) external payable returns (bool) {
        require(msg.value >= 2, "value");
        bytes32 preimage = bytes32(uint256(0xd4));
        bytes32 hashlock = sha256(abi.encodePacked(preimage));

        htlc.lockNative{value: 2}(hashlock, address(holder), type(uint256).max);
        htlc.claim(hashlock, preimage);

        require(htlc.creditOf(address(0), address(holder)) == 2, "native credit missing");
        require(htlc.outstandingCredit(address(0)) == 2, "native outstanding wrong");
        holder.pull(address(htlc), address(0), destination, 2);
        require(destination.balance == 2, "native destination not paid");
        require(htlc.creditOf(address(0), address(holder)) == 0, "native credit not cleared");
        require(htlc.outstandingCredit(address(0)) == 0, "native outstanding not cleared");
        return true;
    }
}
