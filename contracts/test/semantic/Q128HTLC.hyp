==== Source: Q128HTLC.hyp ====
import {HTLC} from "_canonical/HTLC.hyp";

contract Q128HTLC {
    HTLC private htlc;

    constructor() {
        htlc = new HTLC();
    }

    function exerciseRecipientAliases(address firstRecipient, address secondRecipient)
        external
        payable
        returns (bool)
    {
        require(msg.value >= 2, "value");
        bytes32 firstHashlock = bytes32(uint256(1));
        bytes32 secondHashlock = bytes32(uint256(2));
        uint256 timeout = type(uint256).max;

        htlc.lockNative{value: 1}(firstHashlock, firstRecipient, timeout);
        htlc.lockNative{value: 1}(secondHashlock, secondRecipient, timeout);

        HTLC.Swap memory firstSwap = htlc.getSwap(firstHashlock);
        HTLC.Swap memory secondSwap = htlc.getSwap(secondHashlock);
        require(firstSwap.recipient == firstRecipient, "first recipient aliased");
        require(secondSwap.recipient == secondRecipient, "second recipient aliased");
        require(firstSwap.recipient != secondSwap.recipient, "recipient identities collapsed");
        require(firstSwap.initiator == address(this), "first initiator");
        require(secondSwap.initiator == address(this), "second initiator");
        return true;
    }

    function exerciseAssignedAliases(address firstRecipient, address secondRecipient)
        external
        payable
        returns (bool)
    {
        require(msg.value >= 2, "value");
        bytes32 firstHashlock = bytes32(uint256(3));
        bytes32 secondHashlock = bytes32(uint256(4));
        uint256 timeout = type(uint256).max;

        htlc.lockNativeOpen{value: 1}(firstHashlock, timeout);
        htlc.lockNativeOpen{value: 1}(secondHashlock, timeout);
        htlc.assign(firstHashlock, firstRecipient);
        htlc.assign(secondHashlock, secondRecipient);

        HTLC.Swap memory firstSwap = htlc.getSwap(firstHashlock);
        HTLC.Swap memory secondSwap = htlc.getSwap(secondHashlock);
        require(firstSwap.recipient == firstRecipient, "first assignment aliased");
        require(secondSwap.recipient == secondRecipient, "second assignment aliased");
        require(firstSwap.recipient != secondSwap.recipient, "assigned identities collapsed");
        return true;
    }
}
