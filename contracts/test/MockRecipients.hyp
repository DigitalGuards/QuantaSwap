pragma hyperion >=0.0;

// Test-only adversarial payout targets and tokens for the HTLCv3 delivery
// path (issue #47). Never deploy these outside local test runs.
//
// The ERC-20 return conventions the HTLC has to survive live in
// MockTokens.hyp (no-return, always-false, fee-on-transfer, issuer
// blocklist, approval race). This file adds the cases that only matter once
// a failed delivery has to become a credit:
//
//   FalseTransferToken      accepts transferFrom, then declines transfer
//   RevertingTransferToken  accepts transferFrom, then reverts in transfer
//   ReturnBombToken         answers transfer with true plus a huge blob
//   SilentSuccessToken      answers transfer with true and moves nothing
//   SilentNoReturnToken     answers transfer with no data and moves nothing
//   LyingBalanceToken       reports whatever balance it is told to report
//   RevertBombBalanceToken  reverts from balanceOf with an oversized payload
//   GasBurnToken            burns every unit of gas it is given in transfer
//   NonPayableRecipient     cannot receive the native coin at all
//   GasGuzzlerRecipient     burns its whole delivery budget, or reverts
//   ReentrantRecipient      re-enters claim, refund or withdraw on receive

/// @dev The only HTLCv3 surface the mocks need.
interface IHTLCv3Mock {
    function claim(bytes32 hashlock, bytes32 preimage) external;

    function refund(bytes32 hashlock) external;

    function withdraw(address token, address to, uint256 amount) external;

    function withdrawAll(address token, address to) external;
}

// Accepts the lock (transferFrom returns true) and then declines every
// outbound transfer without reverting. Nothing moves, so a credit recorded
// for the full amount stays fully backed.
contract FalseTransferToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        return false;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Accepts the lock and then reverts in transfer. Models a token whose
// outbound path can fail for reasons the HTLC cannot inspect.
contract RevertingTransferToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        revert("transfer disabled");
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Accepts the lock, then answers transfer with `true` followed by an
// oversized tail. The selector is still transfer(address,uint256); only the
// declared return type differs, which is exactly how a hostile token would try
// to make its caller pay for memory expansion. The leading word decodes as a
// successful boolean, so the oversized payload is the only thing standing
// between this and a reported success. Nothing moves, so the credit stays
// backed.
contract ReturnBombToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;
    uint256 private _words = 4096;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function setWords(uint256 words) external {
        _words = words;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external view returns (bool, uint256[] memory) {
        return (true, new uint256[](_words));
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Answers transfer with `true` and moves nothing. This is what an upgradeable
// token whose implementation has gone missing looks like from the outside, and
// what a token that simply lies looks like. A payout must not count as
// delivered.
contract SilentSuccessToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Answers transfer with no return data and moves nothing. A call to an address
// that holds no code answers exactly this way, so the two are indistinguishable
// to the caller. A payout must not count as delivered.
contract SilentNoReturnToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external {
        _allowances[msg.sender][spender] = value;
    }

    function transfer(address, uint256) external {}

    function transferFrom(address from, address to, uint256 value) external {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
    }
}

// Reports whatever balance it is told to report, so a lock can be made to pass
// the exact-received-amount check without any value moving. Used to probe the
// upper bound on a lockable amount, which is what keeps the credit ledger from
// being pushed into a checked-arithmetic overflow.
contract LyingBalanceToken {
    uint256 private _reported;

    function balanceOf(address) external view returns (uint256) {
        return _reported;
    }

    function allowance(address, address) external pure returns (uint256) {
        return type(uint256).max;
    }

    function approve(address, uint256) external pure returns (bool) {
        return true;
    }

    // Moves nothing and reports that it did, so an escrow check based on the
    // reported balance is satisfied by any amount.
    function transferFrom(address, address, uint256 value) external returns (bool) {
        _reported += value;
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        return false;
    }
}

// Accepts the lock, then reverts from balanceOf with a caller-chosen payload
// size. A typed external call re-emits a callee's revert data verbatim, so this
// is how a hostile token pushes a large payload out of the bounded delivery
// frame and charges the settling frame for copying it. The payload is raw
// zeroed memory, which costs the token only the expansion it pays for itself.
contract RevertBombBalanceToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;
    uint256 private _size;
    bool private _armed;

    function arm(uint256 size) external {
        _size = size;
        _armed = true;
    }

    function disarm() external {
        _armed = false;
    }

    function balanceOf(address account) external view returns (uint256) {
        if (_armed) {
            uint256 size = _size;
            assembly {
                revert(0, size)
            }
        }
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Accepts the lock, then burns every unit of gas it is given in transfer. A
// credit in this token cannot be moved by anyone, which is the token's doing
// and not the contract's; value stays conserved and accounted.
contract GasBurnToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;
    uint256 private _sink;
    bool private _armed;

    function arm() external {
        _armed = true;
    }

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address, uint256) external returns (bool) {
        while (_armed) {
            _sink += 1;
        }
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// A contract that cannot accept the native coin: no receive, no fallback.
// It can still collect its credit and name a destination that can.
contract NonPayableRecipient {
    function pull(address htlc, address token, address to, uint256 amount) external {
        IHTLCv3Mock(htlc).withdraw(token, to, amount);
    }

    function pullAll(address htlc, address token, address to) external {
        IHTLCv3Mock(htlc).withdrawAll(token, to);
    }
}

// Burns the entire delivery budget until the child frame runs out of gas
// (mode 1), reverts outright (mode 2), or accepts normally (mode 0).
contract GasGuzzlerRecipient {
    uint256 private _sink;
    uint8 private _mode;

    function setMode(uint8 mode) external {
        _mode = mode;
    }

    function pull(address htlc, address token, address to, uint256 amount) external {
        IHTLCv3Mock(htlc).withdraw(token, to, amount);
    }

    receive() external payable {
        if (_mode == 2) revert("rejected");
        while (_mode == 1) {
            _sink += 1;
        }
    }
}

// Re-enters the HTLC from its receive hook. With `swallow` the revert is
// caught and the delivery still completes, which shows the guard stopped the
// reentry without costing the recipient its payout. Without it the hook
// propagates, the delivery fails, and the amount has to become a credit.
contract ReentrantRecipient {
    uint8 public constant MODE_IDLE = 0;
    uint8 public constant MODE_CLAIM = 1;
    uint8 public constant MODE_REFUND = 2;
    uint8 public constant MODE_WITHDRAW = 3;

    address private _htlc;
    uint8 private _mode;
    bool private _swallow;
    bytes32 private _hashlock;
    bytes32 private _preimage;
    address private _token;
    uint256 private _reentries;
    bool private _lastReentryReverted;

    function configure(
        address htlc,
        uint8 mode,
        bool swallow,
        bytes32 hashlock,
        bytes32 preimage,
        address token
    ) external {
        _htlc = htlc;
        _mode = mode;
        _swallow = swallow;
        _hashlock = hashlock;
        _preimage = preimage;
        _token = token;
    }

    function reentries() external view returns (uint256) {
        return _reentries;
    }

    function lastReentryReverted() external view returns (bool) {
        return _lastReentryReverted;
    }

    function pull(address token, address to, uint256 amount) external {
        IHTLCv3Mock(_htlc).withdraw(token, to, amount);
    }

    receive() external payable {
        uint8 mode = _mode;
        if (mode == MODE_IDLE) return;
        _reentries += 1;
        if (_swallow) {
            _lastReentryReverted = !_tryReenter(mode);
            return;
        }
        _reenter(mode);
    }

    function _tryReenter(uint8 mode) private returns (bool) {
        if (mode == MODE_CLAIM) {
            try IHTLCv3Mock(_htlc).claim(_hashlock, _preimage) {
                return true;
            } catch {
                return false;
            }
        }
        if (mode == MODE_REFUND) {
            try IHTLCv3Mock(_htlc).refund(_hashlock) {
                return true;
            } catch {
                return false;
            }
        }
        try IHTLCv3Mock(_htlc).withdrawAll(_token, address(this)) {
            return true;
        } catch {
            return false;
        }
    }

    function _reenter(uint8 mode) private {
        if (mode == MODE_CLAIM) {
            IHTLCv3Mock(_htlc).claim(_hashlock, _preimage);
            return;
        }
        if (mode == MODE_REFUND) {
            IHTLCv3Mock(_htlc).refund(_hashlock);
            return;
        }
        IHTLCv3Mock(_htlc).withdrawAll(_token, address(this));
    }
}
