pragma hyperion >=0.0;

// Test-only tokens exercising the three ERC-20 return conventions the HTLC
// must handle. Never deploy these outside local test runs.

contract MockERC20 {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    // Test-only seed for paired Q128 owner and spender mapping regressions.
    function seedAllowance(address owner, address spender, uint256 value) external {
        _allowances[owner][spender] = value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address to, uint256 value) external returns (bool) {
        require(_balances[msg.sender] >= value, "balance");
        _balances[msg.sender] -= value;
        _balances[to] += value;
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// USDT-style: state changes but no return value at all.
contract NoReturnToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external {
        _allowances[msg.sender][spender] = value;
    }

    function transfer(address to, uint256 value) external {
        require(_balances[msg.sender] >= value, "balance");
        _balances[msg.sender] -= value;
        _balances[to] += value;
    }

    function transferFrom(address from, address to, uint256 value) external {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
    }
}

// Always returns false without reverting; also doubles as a non-payable
// recipient for native payout failure tests (no receive function).
contract FalseToken {
    function balanceOf(address) external pure returns (uint256) {
        return 0;
    }

    function approve(address, uint256) external pure returns (bool) {
        return true;
    }

    function transfer(address, uint256) external pure returns (bool) {
        return false;
    }

    function transferFrom(address, address, uint256) external pure returns (bool) {
        return false;
    }
}

// Full USDT semantics: no return values (like NoReturnToken) plus the
// approval race guard, so changing a nonzero allowance requires an
// approve(0) reset first. Clients must handle this to support USDT.
contract ApprovalRaceToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external {
        require(value == 0 || _allowances[msg.sender][spender] == 0, "approval race");
        _allowances[msg.sender][spender] = value;
    }

    function transfer(address to, uint256 value) external {
        require(_balances[msg.sender] >= value, "balance");
        _balances[msg.sender] -= value;
        _balances[to] += value;
    }

    function transferFrom(address from, address to, uint256 value) external {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
    }
}

// USDC/USDT-style issuer blocklist: transfers touching a blocked address
// revert. setBlocked is unpermissioned because this is a test double.
contract BlocklistToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;
    mapping(address => bool) private _blocked;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function blocked(address account) external view returns (bool) {
        return _blocked[account];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function setBlocked(address account, bool isBlocked) external {
        _blocked[account] = isBlocked;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address to, uint256 value) external returns (bool) {
        require(!_blocked[msg.sender] && !_blocked[to], "blocked");
        require(_balances[msg.sender] >= value, "balance");
        _balances[msg.sender] -= value;
        _balances[to] += value;
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(!_blocked[from] && !_blocked[to], "blocked");
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value;
        return true;
    }
}

// Fee-on-transfer: the recipient is credited value minus a 1% fee. USDT
// ships this mechanism with the fee currently set to zero; the HTLC must
// reject any token where it is active.
contract FeeToken {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function balanceOf(address account) external view returns (uint256) {
        return _balances[account];
    }

    function allowance(address owner, address spender) external view returns (uint256) {
        return _allowances[owner][spender];
    }

    function mint(address to, uint256 value) external {
        _balances[to] += value;
    }

    function approve(address spender, uint256 value) external returns (bool) {
        _allowances[msg.sender][spender] = value;
        return true;
    }

    function transfer(address to, uint256 value) external returns (bool) {
        require(_balances[msg.sender] >= value, "balance");
        _balances[msg.sender] -= value;
        _balances[to] += value - value / 100;
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(_balances[from] >= value, "balance");
        require(_allowances[from][msg.sender] >= value, "allowance");
        _allowances[from][msg.sender] -= value;
        _balances[from] -= value;
        _balances[to] += value - value / 100;
        return true;
    }
}
