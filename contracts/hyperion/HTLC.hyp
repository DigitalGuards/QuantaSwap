// SPDX-License-Identifier: GPL-3.0
pragma hyperion >=0.0;

/**
 * @title QuantaSwap HTLC
 * @notice Hashed timelock contract for cross-chain atomic swaps between
 *         Ethereum and QRL v2. The same hypc-compiled artifact is deployed
 *         on both chains (both are EVM-compatible), so the two legs run
 *         byte-identical bytecode linked by one shared sha256 hashlock.
 *
 * @dev Design invariants (see docs/ARCHITECTURE.md):
 *   - No owner, no pause, no upgrade path. What is deployed is final.
 *   - claim() is permissionless with the payout target fixed at lock time,
 *     or, for open-recipient locks, at the initiator's one-time assign().
 *     The recipient is write-once: once nonzero it can never change, and
 *     claim() reverts while it is unset, so a sponsored claim (a relayer
 *     submitting for a recipient who has no gas on this chain) can still
 *     only pay the target the fund-owner chose.
 *   - An open-recipient lock is refundable by its initiator at any time via
 *     release() UNTIL assigned; after assign() it behaves identically to a
 *     classic lock (refund only at timeout). release() and a nonzero
 *     recipient are mutually exclusive by construction, so the recipient's
 *     claim guarantee begins the moment assign() lands.
 *   - claim() closes at `timeout`, refund() opens at `timeout`, and
 *     assign() also closes at `timeout`. The windows never overlap, so
 *     timelock reasoning stays simple.
 *   - A hashlock is single-use per contract instance, forever. Records are
 *     never deleted, so a secret whose preimage became public can never
 *     gate funds on this contract again.
 *   - sha256 (not keccak256) so non-EVM counterparties (BTC-family HTLCs)
 *     stay possible later.
 *
 * Ethereum-leg assets: WETH, USDC and USDT (registry: config/tokens.json);
 * the QRL leg uses the native coin. USDT's non-standard ERC-20 surface
 * (no return values) is tolerated by _transferCall. Fee-on-transfer and
 * rebasing tokens are NOT supported, and lockToken enforces that: it
 * verifies the contract received exactly `amount`, so a token that skims
 * a transfer fee (USDT carries a dormant fee switch) cannot create a swap
 * whose payout would be funded by other swaps' escrow.
 */
interface IERC20 {
    function transfer(address to, uint256 value) external returns (bool);
    function transferFrom(address from, address to, uint256 value) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

contract HTLC {
    enum Status {
        None,
        Open,
        Claimed,
        Refunded
    }

    struct Swap {
        address initiator; // funded this leg, refund target
        address recipient; // claim payout target; address(0) while an open lock awaits assign()
        address token; // ERC-20 address, or the zero address for the native coin
        uint256 amount;
        uint256 timeout; // unix time: claim() before it, refund() from it
        Status status;
        bytes32 preimage; // stored on claim for cross-chain observers
    }

    mapping(bytes32 => Swap) private _swaps;

    uint256 private _entered = 1;

    event Locked(
        bytes32 indexed hashlock,
        address indexed initiator,
        address indexed recipient,
        address token,
        uint256 amount,
        uint256 timeout
    );
    event Assigned(bytes32 indexed hashlock, address indexed recipient);
    event Claimed(bytes32 indexed hashlock, bytes32 preimage, address caller);
    event Refunded(bytes32 indexed hashlock);

    error HashlockAlreadyUsed();
    error InvalidParams();
    error SwapNotOpen();
    error WrongPreimage();
    error TimeoutNotReached();
    error TimeoutPassed();
    error TransferFailed();
    error UnsupportedToken();
    error Reentrancy();
    error NotInitiator();
    error AlreadyAssigned();
    error NotAssigned();

    modifier nonReentrant() {
        if (_entered != 1) revert Reentrancy();
        _entered = 2;
        _;
        _entered = 1;
    }

    /// @notice Lock native coin under `hashlock` for `recipient`.
    function lockNative(bytes32 hashlock, address recipient, uint256 timeout) external payable nonReentrant {
        _lock(hashlock, recipient, address(0), msg.value, timeout, false);
    }

    /// @notice Lock `amount` of ERC-20 `token` under `hashlock` for `recipient`.
    /// @dev Requires prior approval for exactly `amount`. Reverts with
    ///      UnsupportedToken unless the contract's balance grows by exactly
    ///      `amount` (rejects fee-on-transfer behavior).
    function lockToken(
        bytes32 hashlock,
        address recipient,
        address token,
        uint256 amount,
        uint256 timeout
    ) external nonReentrant {
        _lockToken(hashlock, recipient, token, amount, timeout, false);
    }

    /// @notice Lock native coin under `hashlock` with the recipient left
    ///         unset (a pre-funded listing). Fix the payout target later
    ///         with assign(), or take the funds back at any time with
    ///         release() while still unassigned.
    function lockNativeOpen(bytes32 hashlock, uint256 timeout) external payable nonReentrant {
        _lock(hashlock, address(0), address(0), msg.value, timeout, true);
    }

    /// @notice Lock `amount` of ERC-20 `token` under `hashlock` with the
    ///         recipient left unset (a pre-funded listing). Same approval
    ///         and exact-received-amount rules as lockToken.
    function lockTokenOpen(
        bytes32 hashlock,
        address token,
        uint256 amount,
        uint256 timeout
    ) external nonReentrant {
        _lockToken(hashlock, address(0), token, amount, timeout, true);
    }

    /// @notice Fix the claim payout target of an open-recipient lock.
    ///         Initiator-only and one-time: the recipient is write-once,
    ///         and once it is set the swap is indistinguishable from a
    ///         classic lock. Closes at `timeout` alongside claim(); past
    ///         it, refund() is already open and a payout target would only
    ///         create claim/refund ambiguity.
    function assign(bytes32 hashlock, address recipient) external nonReentrant {
        Swap storage s = _swaps[hashlock];
        if (s.status != Status.Open) revert SwapNotOpen();
        if (msg.sender != s.initiator) revert NotInitiator();
        if (s.recipient != address(0)) revert AlreadyAssigned();
        if (recipient == address(0)) revert InvalidParams();
        if (block.timestamp >= s.timeout) revert TimeoutPassed();

        s.recipient = recipient;
        emit Assigned(hashlock, recipient);
    }

    /// @notice Return an open-recipient lock's funds to the initiator on
    ///         demand. Valid only while unassigned, before and after
    ///         `timeout` alike (past it this merely duplicates the
    ///         permissionless refund); once assign() lands, the
    ///         timeout-gated refund() is the only way back. Emits Refunded:
    ///         to every observer a release is a refund that happened early.
    function release(bytes32 hashlock) external nonReentrant {
        Swap storage s = _swaps[hashlock];
        if (s.status != Status.Open) revert SwapNotOpen();
        if (msg.sender != s.initiator) revert NotInitiator();
        if (s.recipient != address(0)) revert AlreadyAssigned();

        s.status = Status.Refunded;
        emit Refunded(hashlock);

        _payout(s.token, s.initiator, s.amount);
    }

    /// @notice Pay out to the swap's recipient by revealing the preimage.
    ///         Callable by anyone before `timeout` (sponsored claims).
    function claim(bytes32 hashlock, bytes32 preimage) external nonReentrant {
        Swap storage s = _swaps[hashlock];
        if (s.status != Status.Open) revert SwapNotOpen();
        // An unassigned open lock has no payout target yet; without this
        // guard a native claim would burn the funds to address(0).
        if (s.recipient == address(0)) revert NotAssigned();
        if (block.timestamp >= s.timeout) revert TimeoutPassed();
        if (sha256(abi.encodePacked(preimage)) != hashlock) revert WrongPreimage();

        s.status = Status.Claimed;
        s.preimage = preimage;
        emit Claimed(hashlock, preimage, msg.sender);

        _payout(s.token, s.recipient, s.amount);
    }

    /// @notice Return the locked funds to the initiator once `timeout` passed.
    ///         Callable by anyone; payout target is fixed to the initiator.
    function refund(bytes32 hashlock) external nonReentrant {
        Swap storage s = _swaps[hashlock];
        if (s.status != Status.Open) revert SwapNotOpen();
        if (block.timestamp < s.timeout) revert TimeoutNotReached();

        s.status = Status.Refunded;
        emit Refunded(hashlock);

        _payout(s.token, s.initiator, s.amount);
    }

    function getSwap(bytes32 hashlock) external view returns (Swap memory) {
        return _swaps[hashlock];
    }

    function _lockToken(
        bytes32 hashlock,
        address recipient,
        address token,
        uint256 amount,
        uint256 timeout,
        bool openRecipient
    ) private {
        if (token == address(0) || token.code.length == 0) revert InvalidParams();
        _lock(hashlock, recipient, token, amount, timeout, openRecipient);
        uint256 before = IERC20(token).balanceOf(address(this));
        _transferCall(token, abi.encodeWithSelector(IERC20.transferFrom.selector, msg.sender, address(this), amount));
        if (IERC20(token).balanceOf(address(this)) - before != amount) revert UnsupportedToken();
    }

    function _lock(
        bytes32 hashlock,
        address recipient,
        address token,
        uint256 amount,
        uint256 timeout,
        bool openRecipient
    ) private {
        if (_swaps[hashlock].status != Status.None) revert HashlockAlreadyUsed();
        if (hashlock == bytes32(0) || amount == 0) revert InvalidParams();
        if (!openRecipient && recipient == address(0)) revert InvalidParams();
        if (timeout <= block.timestamp) revert InvalidParams();

        _swaps[hashlock] = Swap({
            initiator: msg.sender,
            recipient: recipient,
            token: token,
            amount: amount,
            timeout: timeout,
            status: Status.Open,
            preimage: bytes32(0)
        });

        emit Locked(hashlock, msg.sender, recipient, token, amount, timeout);
    }

    function _payout(address token, address to, uint256 amount) private {
        if (token == address(0)) {
            (bool ok, ) = to.call{value: amount}("");
            if (!ok) revert TransferFailed();
        } else {
            _transferCall(token, abi.encodeWithSelector(IERC20.transfer.selector, to, amount));
        }
    }

    /// @dev Dependency-free safe ERC-20 call: tolerates no-return tokens,
    ///      rejects a returned `false`.
    function _transferCall(address token, bytes memory data) private {
        (bool ok, bytes memory ret) = token.call(data);
        if (!ok || (ret.length != 0 && !abi.decode(ret, (bool)))) revert TransferFailed();
    }
}
